{
  "expo": {
    "name": "MistyPay",
    "slug": "mistypay",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mistypay",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mistypay.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.mistypay.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "MistyPay needs access to your camera to scan VietQR codes."
        }
      ]
    ]
  }
}
